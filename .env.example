# Etsy app credentials from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_keystring
ETSY_SHARED_SECRET=your_shared_secret
# Must exactly match a callback URL registered on your Etsy app
ETSY_REDIRECT_URI=http://localhost:8000/oauth/callback

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high (higher = better copy, slower and more tokens)
CLAUDE_EFFORT=medium

# How often to pull changes from Etsy (minutes). 0 turns background sync off.
SYNC_INTERVAL_MINUTES=15
# Automatically draft improvements for listings that change and score below the threshold
AUTO_OPTIMIZE=false
AUTO_OPTIMIZE_BELOW_SCORE=70

# Protect the app with a password when it's reachable from the internet
APP_PASSWORD=
SECRET_KEY=replace-with-a-long-random-string

DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
